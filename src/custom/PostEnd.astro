---
// Rendered on each post page, after the share links and before the
// previous/next links. Add comments, a newsletter form or an author bio
// here; use `post` to skip some posts. This file is yours: AstroPaper
// never changes it after release.
//
// jamescscott.net: shows the full series list for posts that belong to one.
import type { CollectionEntry } from "astro:content";
import { getPostUrl } from "@/utils/getPostPaths";
import { getSeriesParts } from "@/utils/getSeriesParts";
import { series } from "@/data/series";

type Props = {
  post: CollectionEntry<"posts">;
};

const { post } = Astro.props;
const key = post.data.series;
const meta = key ? series[key] : undefined;
const parts = key ? await getSeriesParts(key) : [];
---

{meta && parts.length > 0 && (
  <nav
    aria-labelledby="series-nav-title"
    class="border-border bg-surface mt-8 rounded-2xl border p-6"
  >
    <p class="text-accent font-mono text-xs">
      Part {post.data.seriesPart} of {parts.length}
    </p>
    <h2 id="series-nav-title" class="mt-1 mb-4 text-lg font-semibold">
      {meta.title}
    </h2>
    <ol class="flex flex-col gap-1">
      {parts.map(p => {
        const isCurrent = p.post?.id === post.id;
        return (
          <li class="flex gap-3 py-1.5">
            <span class="text-muted-foreground w-6 shrink-0 font-mono text-sm">
              {String(p.part).padStart(2, "0")}
            </span>
            {isCurrent ? (
              <span aria-current="page" class="font-semibold">
                {p.title}
              </span>
            ) : p.post ? (
              <a
                href={getPostUrl(
                  p.post.id,
                  p.post.filePath,
                  Astro.currentLocale
                )}
                class="text-accent underline-offset-4 hover:underline"
              >
                {p.title}
              </a>
            ) : (
              <span class="text-muted-foreground">
                {p.title} <span class="text-xs">(coming soon)</span>
              </span>
            )}
          </li>
        );
      })}
    </ol>
  </nav>
)}
